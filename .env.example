# Ollama Server Configuration
OLLAMA_HOST=http://127.0.0.1:11434

# Language Model (Qwen 2.5 3B recommended for 8GB Mac M1)
CHAT_MODEL=qwen2.5:3b

# Embedding Model (nomic-embed-text or snowflake-arctic-embed)
EMBEDDING_MODEL=snowflake-arctic-embed

# Supabase Cloud Configuration (For Google/Apple Auth & Project Sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini API Key (For Lead Agent 100-pt Job Scoring & Evaluation)
GEMINI_API_KEY=your-google-gemini-api-key
